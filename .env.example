# 필수 — 없으면 프로세스 시작 실패. 앱 전용 읽기 전용 롤(sql/ipostock_app.sql)로 접속
DATABASE_URL=postgresql://ipostock_app:<password>@<host>:5432/ipostock

# 선택 — IPO 목록/상세. production host에서는 필수
# 브라우저·클라이언트 번들에 노출 금지. 예: openssl rand -hex 32
IPO_STOCK_API_KEY=

# 테스트 — pytest -m integration 만. 비통합 테스트는 불필요
DATABASE_TEST_URL=
