# 필수 — 없으면 프로세스 시작 실패
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# 선택 — IPO 목록/상세. production host에서는 둘 다 필수
# 브라우저·클라이언트 번들에 노출 금지. 예: openssl rand -hex 32
SUPABASE_SECRET_KEY=
IPO_STOCK_API_KEY=

# 테스트 — pytest -m integration 만. 비통합 테스트는 불필요
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_ACCESS_TOKEN=
